# syntax=docker/dockerfile:1

# r4 is the verified v0.5.75 runtime with cache telemetry and the overflow guard.
ARG BASE_IMAGE=9router:cachefix-claude-usage-20260913-v075-r4
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="9router cache telemetry + OpenRouter session overlay" \
      org.opencontainers.image.version="0.5.75" \
      org.opencontainers.image.base.name="upstream:v0.5.75" \
      com.9router.source.ref="main"

COPY open-sse/services/accountFallback.js /app/open-sse/services/accountFallback.js
COPY open-sse/executors/index.js /app/open-sse/executors/index.js
COPY open-sse/executors/openrouter.js /app/open-sse/executors/openrouter.js
COPY open-sse/handlers/chatCore.js /app/open-sse/handlers/chatCore.js
COPY open-sse/utils/sessionManager.js /app/open-sse/utils/sessionManager.js
